[resource]
script = ExtResource("1_data")
id = &"cachimbo_fumo"
display_name = "Cachimbo e Fumo de Corda"
description = "Um cachimbo de madeira escura, com a haste gasta e um resto de fumo de corda. O cheiro é antigo e familiar."
insight_text = "O Saci falou de bambu, de sete anos lá dentro e de setenta e sete anos de travessuras. Talvez esse cheiro o ajude a lembrar de quem era antes."
