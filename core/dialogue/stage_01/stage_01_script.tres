[sub_resource type="Resource" id="Choice_96_1"]
script = ExtResource("3_choice")
id = &"item"
label = "Item"
next_id = &"battle.items"

[sub_resource type="Resource" id="Choice_96_2"]
script = ExtResource("3_choice")
id = &"confront"
label = "Confrontar"
next_id = &"battle.confront"

[sub_resource type="Resource" id="Choice_96_3"]
