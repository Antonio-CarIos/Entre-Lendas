effect_id = &"claim_peneira"

[sub_resource type="Resource" id="Choice_82_1"]
script = ExtResource("3_choice")
id = &"investigate"
label = "Vou investigar mais"
next_id = &"vendor.distrust"
condition_id = &"wall_or_tram_unseen"

[sub_resource type="Resource" id="Choice_82_2"]
script = ExtResource("3_choice")
id = &"back"
label = "Voltar"

[sub_resource type="Resource" id="Entry_82"]
script = ExtResource("2_entry")
id = &"vendor.recipe"
scene_id = &"scene_07"
speaker = "Quitandeira"
text = "Minha avó dizia assim: pega uma peneira, amarra uma fita em cruz, e joga no redemoinho. Ele fica preso lá dentro. Aí tem que botar numa garrafa bem tampada."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_82_0"), SubResource("Choice_82_1"), SubResource("Choice_82_2")])

[sub_resource type="Resource" id="Entry_83"]
script = ExtResource("2_entry")
id = &"vendor.give"
scene_id = &"scene_07"
speaker = "Quitandeira"
text = "Toma a peneira. Mas não me deixa sozinha com ele, hein?"
condition_id = &"sieve_not_claimed"

[sub_resource type="Resource" id="Entry_84"]
script = ExtResource("2_entry")
id = &"vendor.distrust"
scene_id = &"scene_07"
speaker = "Quitandeira"
text = "Antes, dê uma olhada no muro ou no bonde. Talvez tenham deixado alguma pista. Eu fico aqui... mas volte, está bem?"

[sub_resource type="Resource" id="Entry_85"]
script = ExtResource("2_entry")
id = &"vendor.already_helped"
scene_id = &"scene_07"
speaker = "Quitandeira"
text = "A peneira que eu tinha está com você. Minha avó dizia: fita em cruz, redemoinho e garrafa bem tampada. Tome cuidado."
condition_id = &"sieve_claimed"

[sub_resource type="Resource" id="Entry_86"]
script = ExtResource("2_entry")
id = &"bamboo.crack"
scene_id = &"scene_07"
text = "Um gomo de bambu rachado ao meio, sozinho no chão. Dentro, uma marca de mãozinha minúscula.
O vento passa pelo bambu e faz um som que parece uma risadinha."

[sub_resource type="Resource" id="Entry_87"]
script = ExtResource("2_entry")
id = &"journal.bamboo"
scene_id = &"journal"
text = "Em muitas versões, o Saci nasce dentro de um gomo de bambu, onde passa sete anos antes de sair."
condition_id = &"clue:clue_bambu_rachado"

[sub_resource type="Resource" id="Entry_88"]
script = ExtResource("2_entry")
id = &"journal.origin"
scene_id = &"journal"
text = "Em algumas versões, o Saci nasce num gomo de bambu, onde passa sete anos ouvindo o vento. Ao sair, tem setenta e sete anos para aprontar; depois, dizem, vira cogumelo.
Outras narrativas lembram um menino travesso ligado à mata, o Saci-Cererê. Cada causo guarda uma parte diferente dessa história."
condition_id = &"clue:clue_origem_saci"

[sub_resource type="Resource" id="Entry_89"]
script = ExtResource("2_entry")
id = &"journal.wall_power"
scene_id = &"journal"
text = "Quem perde o gorro perde o rumo.
O gorro aparece ligado ao poder do Saci. Quem consegue guardá-lo pode ter uma escolha difícil nas mãos."
condition_id = &"clue:clue_poder_gorro_parede"

[sub_resource type="Resource" id="Entry_90"]
script = ExtResource("2_entry")
id = &"journal.mural"
scene_id = &"journal"
text = "O menino da mata, o bambu, a roda de capoeira, o gorro e o vento.
As versões do Saci se transformam com quem as conta. Narrativas indígenas, africanas e europeias se encontram nesses causos. Não existe uma única história que apague todas as outras.
Travessuras com leite, fogo, objetos e crina dos cavalos continuam reaparecendo nas histórias."
condition_id = &"clue:clue_mural_origens"

[sub_resource type="Resource" id="Entry_91"]
script = ExtResource("2_entry")
id = &"journal.bonus"
scene_id = &"journal"
text = "Dia do Saci — 31 de outubro

Uma data para lembrar o Saci e celebrar os causos do folclore brasileiro. Cada pessoa que conta uma história também ajuda a mantê-la viva."
condition_id = &"clue:clue_dia_do_saci_bonus"

[sub_resource type="Resource" id="Choice_92_0"]
script = ExtResource("3_choice")
id = &"climb"
label = "Subir"
next_id = &"climax.climb"
effect_id = &"enter_climax"

[sub_resource type="Resource" id="Choice_92_1"]
script = ExtResource("3_choice")
id = &"return"
label = "Voltar"

[sub_resource type="Resource" id="Entry_92"]
script = ExtResource("2_entry")
id = &"climax.warning"
scene_id = &"scene_08"
text = "O vento diz que ainda tem coisa para ver. Subir assim mesmo?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_92_0"), SubResource("Choice_92_1")])

[sub_resource type="Resource" id="Entry_93"]
script = ExtResource("2_entry")
id = &"climax.climb"
scene_id = &"scene_08"
text = "As pegadas de uma perna só se juntam numa trilha só. Elas sobem. Você sobe junto.
O vento aumenta a cada degrau. As roupas dos postes voam na mesma direção. Até o céu parece girar."
event_id = &"intro_climb"

[sub_resource type="Resource" id="Entry_94"]
script = ExtResource("2_entry")
id = &"climax.arrival"
scene_id = &"scene_08"
text = "A praça está no centro de um furacão. Bancos, páginas, sapatos, gorros... tudo girando devagar.
No meio, uma figura de uma perna só, rindo. Já não é uma risadinha. É uma risada que ocupa o céu inteiro."
event_id = &"intro_climax"

[sub_resource type="Resource" id="Entry_95"]
script = ExtResource("2_entry")
id = &"battle.opening"
scene_id = &"scene_08"
speaker = "Saci"
text = "Você achou meu gorro, você? Achou meu cachimbo, meu mural, meu bambu? Então sabe tudo o que importa... e quase nada ao mesmo tempo.
Hihihi! Todo mundo quer me pegar, todo mundo quer me ouvir. Ninguém quer as duas coisas."
next_id = &"battle.question"

[sub_resource type="Resource" id="Choice_96_0"]
script = ExtResource("3_choice")
id = &"talk"
label = "Interagir / Brincar"
