next_id = &"battle.praise"

[sub_resource type="Resource" id="Entry_97"]
script = ExtResource("2_entry")
id = &"battle.act"
scene_id = &"scene_08"
text = "Como você quer se aproximar do Saci?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_97_0"), SubResource("Choice_97_1"), SubResource("Choice_97_2"), SubResource("Choice_97_3")])

[sub_resource type="Resource" id="Entry_98"]
script = ExtResource("2_entry")
id = &"battle.joke"
scene_id = &"scene_08"
text = "O que é, o que é: cai em pé e corre deitado?
O Saci tenta segurar a risada. Não consegue."

[sub_resource type="Resource" id="Entry_99"]
script = ExtResource("2_entry")
id = &"battle.play"
scene_id = &"scene_08"
text = "Você acompanha o ritmo do vento.
O Saci dá uma volta a mais só para ver se você acompanha.
Hihihi!"

[sub_resource type="Resource" id="Entry_100"]
script = ExtResource("2_entry")
id = &"battle.praise"
scene_id = &"scene_08"
text = "Você comenta uma das travessuras que encontrou pelo caminho.
Pela primeira vez, ele parece interessado em ouvir sua versão."

[sub_resource type="Resource" id="Entry_101"]
script = ExtResource("2_entry")
id = &"battle.items"
scene_id = &"scene_08"
text = "O que você quer mostrar ao Saci?"
stage_direction = "Submenu usa os itens realmente presentes; sem gerar itens a partir do texto."

[sub_resource type="Resource" id="Entry_102"]
script = ExtResource("2_entry")
id = &"battle.confront"
scene_id = &"scene_08"
text = "Você tenta agarrar o vento com as mãos vazias.
O Saci apenas ri.
Hihihi!"
stage_direction = "Se a peneira já contiver o Saci, a ação muda para Segurar Peneira."

[sub_resource type="Resource" id="Entry_103"]
script = ExtResource("2_entry")
id = &"battle.trick_tangle"
scene_id = &"scene_08"
speaker = "Saci"
text = "Vou embolar sua linha!"
stage_direction = "Resposta de turno, sem controles invertidos na exploração nem remoção definitiva de itens."

[sub_resource type="Resource" id="Entry_104"]
script = ExtResource("2_entry")
id = &"battle.trick_key"
scene_id = &"scene_08"
speaker = "Saci"
text = "Vou esconder sua chave!"
stage_direction = "Resposta de turno, sem controles invertidos na exploração nem remoção definitiva de itens."

[sub_resource type="Resource" id="Entry_105"]
script = ExtResource("2_entry")
id = &"battle.trick_milk"
scene_id = &"scene_08"
speaker = "Saci"
text = "Vou azedar seu leite!"
stage_direction = "Resposta de turno, sem controles invertidos na exploração nem remoção definitiva de itens."

[sub_resource type="Resource" id="Entry_106"]
script = ExtResource("2_entry")
id = &"capture.sieve"
scene_id = &"scene_08"
text = "A peneira gira no ar. A fita vermelha faz a cruz. Por um instante, o redemoinho inteiro cabe dentro dela."
stage_direction = "Ação por turno: usar peneira com cruz, sem timing obrigatório."

[sub_resource type="Resource" id="Entry_107"]
script = ExtResource("2_entry")
id = &"capture.hold"
scene_id = &"scene_08"
text = "O Saci se debate sob a peneira. Você a mantém firme."
stage_direction = "Ação por turno: Segurar Peneira ou mostrar o gorro; sem barra de força."

[sub_resource type="Resource" id="Entry_108"]
script = ExtResource("2_entry")
id = &"capture.plea"
scene_id = &"scene_08"
speaker = "Saci"
text = "Não! Não! A rolha, não! Eu ia devolver! Eu ia..."
next_id = &"capture.bottle"

[sub_resource type="Resource" id="Entry_109"]
script = ExtResource("2_entry")
id = &"capture.bottle"
scene_id = &"scene_08"
text = "Pop.
A garrafa tampada pesa na sua mão. Lá dentro, uma fumaça gira devagar. Sempre no mesmo sentido."
stage_direction = "Fechar garrafa por ação de turno, sem arrastar com mouse."

[sub_resource type="Resource" id="Entry_110"]
script = ExtResource("2_entry")
id = &"capture.epilogue"
scene_id = &"epilogue_capture"
text = "A rua volta ao lugar. As roupas descem dos postes. Os desenhos desbotam. A casa se arruma sozinha.
Tudo está em ordem. Silêncio.
Você olha para a garrafa. Ela parece um pouco mais pesada do que antes."
event_id = &"epilogue_capture_seen"

[sub_resource type="Resource" id="Entry_111"]
script = ExtResource("2_entry")
id = &"capture.remorse"
scene_id = &"epilogue_capture"
text = "Você sabia o que ele era. Foi assim mesmo?"
stage_direction = "Paleta saturada e silêncio, sem risadinha."
condition_id = &"four_read_clues"

[sub_resource type="Resource" id="Entry_112"]
script = ExtResource("2_entry")
id = &"friendship.lower_tools"
scene_id = &"scene_08"
text = "Você deixa de lado a ideia de prender o Saci.
O vento parece esperar."
stage_direction = "Evita citar peneira ou garrafa que podem não estar no inventário."
next_id = &"friendship.surprise"

[sub_resource type="Resource" id="Entry_113"]
script = ExtResource("2_entry")
id = &"friendship.surprise"
scene_id = &"scene_08"
speaker = "Saci"
text = "Hm? Vai desistir? Todo mundo que chega até aqui me quer na garrafa."

[sub_resource type="Resource" id="Entry_114"]
script = ExtResource("2_entry")
id = &"friendship.offer_pipe"
scene_id = &"scene_08"
text = "Você estende o cachimbo e o fumo de corda."
next_id = &"friendship.pipe_memory"

[sub_resource type="Resource" id="Entry_115"]
script = ExtResource("2_entry")
id = &"friendship.pipe_memory"
scene_id = &"scene_08"
speaker = "Saci"
text = "... Onde achou isso? Esse cheiro. Esse bambu. Isso é meu de antes."
stage_direction = "A fumaça forma por um instante um menino de duas pernas rindo."

[sub_resource type="Resource" id="Entry_116"]
script = ExtResource("2_entry")
id = &"friendship.origin"
scene_id = &"scene_08"
speaker = "Você"
text = "Você nasceu num gomo de bambu. Era um menino da mata, chamado Saci-Cererê. Depois a lenda cresceu com muitos povos."
next_id = &"friendship.remembered"

[sub_resource type="Resource" id="Entry_117"]
script = ExtResource("2_entry")
id = &"friendship.remembered"
scene_id = &"scene_08"
speaker = "Saci"
text = "... Ninguém lembra disso. Todo mundo só lembra do gorro e do susto."

[sub_resource type="Resource" id="Entry_118"]
script = ExtResource("2_entry")
id = &"friendship.return_hat"
scene_id = &"scene_08"
text = "Você estende o gorro vermelho. O vento para completamente."
next_id = &"friendship.hat_power"

[sub_resource type="Resource" id="Entry_119"]
script = ExtResource("2_entry")
id = &"friendship.hat_power"
scene_id = &"scene_08"
speaker = "Saci"
text = "Você podia mandar em mim com isso. Sabia?"
next_id = &"friendship.hat_reply"

[sub_resource type="Resource" id="Entry_120"]
script = ExtResource("2_entry")
id = &"friendship.hat_reply"
scene_id = &"scene_08"
text = "Você: Sabia.
Saci: ...E mesmo assim devolveu."

[sub_resource type="Resource" id="Entry_121"]
script = ExtResource("2_entry")
id = &"friendship.empathy"
scene_id = &"epilogue_friendship"
speaker = "Saci"
text = "Você foi o primeiro que perguntou se eu estava preso há muito tempo. Ninguém mais perguntou."
condition_id = &"saci_empatico"

[sub_resource type="Resource" id="Entry_122"]
script = ExtResource("2_entry")
id = &"friendship.paint_gorro"
scene_id = &"epilogue_friendship"
speaker = "Saci"
text = "Vi seu desenho no muro. O gorro ficou torto. Mas ficou meu."
condition_id = &"painted_gorro"

[sub_resource type="Resource" id="Entry_123"]
script = ExtResource("2_entry")
id = &"friendship.paint_bambu"
scene_id = &"epilogue_friendship"
speaker = "Saci"
text = "Vi seu desenho no muro. O bambu ficou torto. Mas ficou meu."
condition_id = &"painted_bambu"

[sub_resource type="Resource" id="Entry_124"]
script = ExtResource("2_entry")
id = &"friendship.paint_redemoinho"
scene_id = &"epilogue_friendship"
speaker = "Saci"
text = "Vi seu desenho no muro. O redemoinho ficou torto. Mas ficou meu."
condition_id = &"painted_redemoinho"

[sub_resource type="Resource" id="Entry_125"]
script = ExtResource("2_entry")
id = &"friendship.promise"
scene_id = &"epilogue_friendship"
speaker = "Saci"
text = "Está bem, você. Eu arrumo tudo. Mas amanhã eu bagunço de novo, hein?"
next_id = &"friendship.epilogue"

[sub_resource type="Resource" id="Entry_126"]
script = ExtResource("2_entry")
id = &"friendship.epilogue"
scene_id = &"epilogue_friendship"
text = "As roupas voltam aos varais. Os desenhos viram flores no muro. A garrafa vazia fica no chão, esquecida.
Ao longe, uma risadinha. Alegre."
stage_direction = "Redemoinho em pétalas; arte escolhida no mural preservada entre flores."
event_id = &"epilogue_friendship_seen"

[sub_resource type="Resource" id="Entry_127"]
script = ExtResource("2_entry")
id = &"incomplete.arrival"
scene_id = &"incomplete_recovery"
text = "Você chega à praça sem entender nada. O Saci ri, gira duas vezes e perde a graça."
next_id = &"incomplete.bored"

[sub_resource type="Resource" id="Entry_128"]
script = ExtResource("2_entry")
id = &"incomplete.bored"
scene_id = &"incomplete_recovery"
speaker = "Saci"
text = "Você nem sabe quem eu sou. Que tédio."
next_id = &"incomplete.clock"

[sub_resource type="Resource" id="Entry_129"]
script = ExtResource("2_entry")
id = &"incomplete.clock"
scene_id = &"incomplete_recovery"
text = "Quase tudo está em ordem. Um relógio, na sala, ainda gira ao contrário."
stage_direction = "Retorno seguro à investigação; não registra resultado moral e não remove recursos."

