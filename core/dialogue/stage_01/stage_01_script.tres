[sub_resource type="Resource" id="Entry_96"]
script = ExtResource("2_entry")
id = &"battle.question"
scene_id = &"scene_08"
text = "O vento para por um instante. O Saci está parado à sua frente, de olhos arregalados, o gorro balançando.
Saci: E agora, você? O que você vai fazer comigo?"
stage_direction = "Troca das duas opções antigas pelo menu de quatro ações da revisão RPG. Saci em batalha é um quadrado vermelho provisório, a pedido do usuário."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_96_0"), SubResource("Choice_96_1"), SubResource("Choice_96_2"), SubResource("Choice_96_3")])

[sub_resource type="Resource" id="Choice_97_0"]
script = ExtResource("3_choice")
id = &"joke"
label = "Contar piada / adivinha"
next_id = &"battle.joke"

[sub_resource type="Resource" id="Choice_97_1"]
script = ExtResource("3_choice")
id = &"play"
label = "Entrar na brincadeira"
next_id = &"battle.play"

[sub_resource type="Resource" id="Choice_97_2"]
script = ExtResource("3_choice")
id = &"origin"
label = "Contar a origem"
next_id = &"friendship.origin"
condition_id = &"three_read_clues"

[sub_resource type="Resource" id="Choice_97_3"]
script = ExtResource("3_choice")
id = &"praise"
