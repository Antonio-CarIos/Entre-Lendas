[gd_scene format=3]

[ext_resource type="Script" path="res://ui/dialogue_view.gd" id="script"]

[node name="Story" type="PanelContainer"]
visible = false
layout_mode = 1
anchor_top = 0.12
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 4.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"InfoPanel"
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6
mouse_filter = 2

[node name="Speaker" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.88, 0.66, 0.27, 1)
text = "Narração"

[node name="Body" type="Label" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
autowrap_mode = 3

[node name="Choices" type="ScrollContainer" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="Options" type="VBoxContainer" parent="Margin/Column/Choices"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
